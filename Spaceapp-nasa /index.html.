  <style>
    body {
      background-color: #0b051d;
      color: #ffffff;
      overflow-x: hidden;
    }

    /* Animated Starfield & Orbital Background */
    .space-canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at 15% 20%, rgba(139, 92, 246, 0.22) 0%, transparent 42%),
        radial-gradient(circle at 85% 15%, rgba(0, 240, 255, 0.14) 0%, transparent 38%),
        radial-gradient(circle at 75% 82%, rgba(236, 72, 153, 0.16) 0%, transparent 45%),
        radial-gradient(circle at 20% 85%, rgba(249, 115, 22, 0.12) 0%, transparent 40%),
        linear-gradient(180deg, #0b051d 0%, #13092e 55%, #090417 100%);
    }

    @keyframes twinkle {
      0%, 100% { opacity: 0.25; transform: scale(0.9); }
      50% { opacity: 0.95; transform: scale(1.15); }
    }

    @keyframes slowOrbit {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes reverseOrbit {
      from { transform: rotate(360deg); }
      to { transform: rotate(0deg); }
    }

    @keyframes floatPlanet {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    .orbit-spin {
      animation: slowOrbit 42s linear infinite;
      transform-origin: center;
    }

    .orbit-spin-fast {
      animation: reverseOrbit 24s linear infinite;
      transform-origin: center;
    }

    .planet-float {
      animation: floatPlanet 7s ease-in-out infinite;
    }

    .glass-card {
      background: rgba(26, 14, 61, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(139, 92, 246, 0.28);
      box-shadow: 0 10px 30px rgba(5, 2, 18, 0.55);
    }

    .glass-card-hover {
      transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    }

    .glass-card-hover:hover {
      transform: translateY(-2px);
      border-color: rgba(0, 240, 255, 0.55);
      box-shadow: 0 14px 34px rgba(0, 240, 255, 0.12);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
